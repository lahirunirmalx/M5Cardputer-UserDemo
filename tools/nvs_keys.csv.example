key,type,encoding,value
# -----------------------------------------------------------------------------
# TEMPLATE — copy this file before editing so your real secrets don't end up
# in git:
#     cp tools/nvs_keys.csv.example tools/nvs_keys.csv
# `tools/nvs_keys.csv` is listed in .gitignore.
#
# Build the binary (esp-idf v4.4.6):
#   python3 $IDF_PATH/components/nvs_flash/nvs_partition_generator/nvs_partition_gen.py \
#       generate tools/nvs_keys.csv tools/nvs.bin 0x5000
#
# Flash to the device (does NOT touch the app image):
#   esptool.py -p /dev/ttyACM0 write_flash 0x9000 tools/nvs.bin
#
# Or use tools/flash_nvs.sh which wraps both steps. Partition layout lives in
# partitions.csv — keep 0x9000 and size 0x5000 in sync.
#
# Lines starting with `#` are ignored by the generator.
# -----------------------------------------------------------------------------

# WiFi — five-slot LRU store, read by main/hal/hal.h::loadWifiFromNvs().
#
#   count  u8     number of valid slots in use (1..5). Set this to match the
#                 number of ssidN/passN pairs you actually fill in.
#   ssid0  str    most-recently-saved SSID — tried FIRST on boot
#   pass0  str
#   ssid1  str    next-most-recent fallback
#   pass1  str
#   ...    str    up to ssid4 / pass4
#
# On boot, the Launcher's auto-connect sweeps slot 0 → slot 4 with a 15 s
# timeout each. The first SSID that associates wins and gets promoted to
# slot 0 for the next reboot. When the Set WiFi app saves a new credential,
# it pushes onto slot 0; if all five slots were already in use, the oldest
# (slot 4) is evicted.
#
# Legacy fallback: if `count` is absent on a pre-existing device, the loader
# reads the original single-slot keys `ssid` / `pass` into slot 0 — so
# upgrading firmware on a device with an old NVS image still works without
# re-provisioning.
#
# Fill in only as many slots as you have networks; leave the rest commented
# out and lower `count` accordingly. Empty slots break the auto-connect
# sweep (it skips them, but the count must be accurate).
wifi,namespace,,
count,data,u8,1
ssid0,data,string,YourPrimaryWiFiSSID
pass0,data,string,YourPrimaryWiFiPassword
# ssid1,data,string,YourSecondaryWiFiSSID
# pass1,data,string,YourSecondaryWiFiPassword
# ssid2,data,string,YourThirdWiFiSSID
# pass2,data,string,YourThirdWiFiPassword
# ssid3,data,string,YourFourthWiFiSSID
# pass3,data,string,YourFourthWiFiPassword
# ssid4,data,string,YourFifthWiFiSSID
# pass4,data,string,YourFifthWiFiPassword

# Claude usage API (read by app_claudemeter)
#   base   = http://<host>:<port> (no trailing slash)
#   bearer = the token from your claude-usage server
claude,namespace,,
base,data,string,http://192.168.1.100:7878
bearer,data,string,REPLACE_WITH_YOUR_BEARER_TOKEN

# Gemini API (read by app_gemini; also editable via that app)
gemini,namespace,,
apikey,data,string,REPLACE_WITH_YOUR_GEMINI_API_KEY
